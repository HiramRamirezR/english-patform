  "evaluations": [
    {
      "id": "m8_eval_1",
      "title": "Evaluación M8: Forest Challenges",
      "preview": {
        "en": "You and Moon are at the forest campfire! Talk about what you can and can't do in the forest.",
        "es": "¡Tú y Moon están en la fogata del bosque! Hablen sobre lo que pueden y no pueden hacer en el bosque."
      },
      "lines": [
        { "role": "moon", "en": "Welcome to the forest campfire! Let's talk about what you can do!", "es": "¡Bienvenido a la fogata del bosque! ¡Hablemos de lo que puedes hacer!" },
        { "role": "student", "en": "(Greet Moon and say you are happy!)", "es": "(Saluda a Moon y di que estás feliz.)" },
        { "role": "moon", "en": "Can you swim in the river?", "es": "¿Puedes nadar en el río?" },
        { "role": "student", "en": "(Say: Yes, I can swim! The water is cold!)", "es": "(Di: Sí, ¡puedo nadar! ¡El agua está fría!)" },
        { "role": "moon", "en": "Can you fly like a bird?", "es": "¿Puedes volar como un pájaro?" },
        { "role": "student", "en": "(Say: No, I can't fly! I am not a bird!)", "es": "(Di: No, ¡no puedo volar! ¡No soy un pájaro!)" },
        { "role": "moon", "en": "Can you climb the big mountain?", "es": "¿Puedes subir la montaña grande?" },
        { "role": "student", "en": "(Say: Yes, I can climb! It is high!)", "es": "(Di: Sí, ¡puedo subir! ¡Es alta!)" },
        { "role": "moon", "en": "Can you eat apples from the tree?", "es": "¿Puedes comer manzanas del árbol?" },
        { "role": "student", "en": "(Say: Yes, I can eat! Apples are yummy!)", "es": "(Di: Sí, ¡puedo comer! ¡Las manzanas son ricas!)" },
        { "role": "moon", "en": "Can you jump over the bridge?", "es": "¿Puedes saltar sobre el puente?" },
        { "role": "student", "en": "(Say: Yes, I can jump! I am careful!)", "es": "(Di: Sí, ¡puedo saltar! ¡Tengo cuidado!)" },
        { "role": "moon", "en": "Can you play in the dangerous cave?", "es": "¿Puedes jugar en la cueva peligrosa?" },
        { "role": "student", "en": "(Say: No, I can't play there! It is dangerous!)", "es": "(Di: No, ¡no puedo jugar ahí! ¡Es peligrosa!)" },
        { "role": "moon", "en": "What can you do in the forest?", "es": "¿Qué puedes hacer en el bosque?" },
        { "role": "student", "en": "(Say: I can swim, climb, run, and eat! I can't fly!)", "es": "(Di: Puedo nadar, subir, correr y comer. ¡No puedo volar!)" },
        { "role": "moon", "en": "Wonderful! You know all the forest challenges. Thank you!", "es": "¡Maravilloso! Conoces todos los desafíos del bosque. ¡Gracias!" },
        { "role": "student", "en": "(Say goodbye and thank Moon for the adventure!)", "es": "(Despídete y agradece a Moon por la aventura.)" }
      ]
    }
  ]
}
