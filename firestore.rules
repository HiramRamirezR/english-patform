rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Funciones de ayuda
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    
    // Reglas para la colección de usuarios (PRIVADA)
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId 
                      && request.resource.data.get('isAdmin', false) == false;
      allow update: if (isAdmin()) || 
                      (isSignedIn() && request.auth.uid == userId 
                      && request.resource.data.get('isAdmin', false) == false);
    }

    // Reglas para la colección de maestros (PÚBLICA para alumnos)
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || request.auth.uid == teacherId);
    }

    // Reglas para la colección de slots / agenda
    match /slots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == request.resource.data.teacherId);
      allow update, delete: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.teacherId);
    }

    // Reglas para evaluaciones
    match /evaluations/{evalId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Por seguridad, bloqueamos cualquier otra colección no definida (solo admin)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}