  "evaluations": [
    {
      "id": "m6_eval_1",
      "title": "Evaluación M6: What Do You Have?",
      "preview": {
        "en": "You and Moon are at the campfire! Talk about what you have in your backpack.",
        "es": "¡Tú y Moon están en la fogata! Hablen sobre lo que tienen en su mochila."
      },
      "lines": [
        { "role": "moon", "en": "Welcome to the campfire, explorer! Let's see your backpack!", "es": "¡Bienvenido a la fogata, explorador! ¡Veamos tu mochila!" },
        { "role": "student", "en": "(Say hello to Moon and say you are ready!)", "es": "(Saluda a Moon y di que estás listo.)" },
        { "role": "moon", "en": "Do you have a backpack?", "es": "¿Tienes una mochila?" },
        { "role": "student", "en": "(Say: Yes, I have a backpack!)", "es": "(Di: ¡Sí, tengo una mochila!)" },
        { "role": "moon", "en": "Great! Do you have a map?", "es": "¡Genial! ¿Tienes un mapa?" },
        { "role": "student", "en": "(Say: Yes, I have a map!)", "es": "(Di: ¡Sí, tengo un mapa!)" },
        { "role": "moon", "en": "Do you have a compass?", "es": "¿Tienes una brújula?" },
        { "role": "student", "en": "(Say: Yes, I have a compass!)", "es": "(Di: ¡Sí, tengo una brújula!)" },
        { "role": "moon", "en": "Do you have a tent?", "es": "¿Tienes una carpa?" },
        { "role": "student", "en": "(Say: No, I don't have a tent.)", "es": "(Di: No, no tengo una carpa.)" },
        { "role": "moon", "en": "Do you have a flashlight?", "es": "¿Tienes una linterna?" },
        { "role": "student", "en": "(Say: Yes, I have a flashlight!)", "es": "(Di: ¡Sí, tengo una linterna!)" },
        { "role": "moon", "en": "Do you have water and food?", "es": "¿Tienes agua y comida?" },
        { "role": "student", "en": "(Say: Yes, I have water and food!)", "es": "(Di: ¡Sí, tengo agua y comida!)" },
        { "role": "moon", "en": "Do you have a knife?", "es": "¿Tienes un cuchillo?" },
        { "role": "student", "en": "(Say: No, I don't have a knife.)", "es": "(Di: No, no tengo un cuchillo.)" },
        { "role": "moon", "en": "You have so many things! You are a great explorer!", "es": "¡Tienes tantas cosas! ¡Eres un gran explorador!" },
        { "role": "student", "en": "(Say thank you and goodbye to Moon!)", "es": "(Da las gracias y despídete de Moon.)" }
      ]
    }
  ]
