  "evaluations": [
    {
      "id": "m5_eval_1",
      "title": "Evaluación M5: What Are You Doing?",
      "preview": {
        "en": "You and Moon are at the Movement Festival! Talk about what everyone is doing right now.",
        "es": "¡Tú y Moon están en el Festival de Movimiento! Hablen sobre lo que todos están haciendo ahora."
      },
      "lines": [
        { "role": "moon", "en": "Welcome to the Movement Festival! So many things happening!", "es": "¡Bienvenido al Festival de Movimiento! ¡Tantas cosas pasando!" },
        { "role": "student", "en": "(Greet Moon and say you are happy and excited!)", "es": "(Saluda a Moon y di que estás feliz y emocionado.)" },
        { "role": "moon", "en": "Look! A bird is flying. What is it doing?", "es": "¡Mira! Un pájaro está volando. ¿Qué está haciendo?" },
        { "role": "student", "en": "(Say: The bird is flying! It is fast!)", "es": "(Di: ¡El pájaro está volando! Es rápido.)" },
        { "role": "moon", "en": "And over there, a boy is dancing. What is he doing?", "es": "Y allá, un niño está bailando. ¿Qué está haciendo?" },
        { "role": "student", "en": "(Say: He is dancing! He is happy.)", "es": "(Di: ¡Él está bailando! Él está feliz.)" },
        { "role": "moon", "en": "I am singing! Can you hear me? What am I doing?", "es": "¡Estoy cantando! ¿Puedes oírme? ¿Qué estoy haciendo?" },
        { "role": "student", "en": "(Say: You are singing, Moon! You are amazing.)", "es": "(Di: ¡Estás cantando, Moon! Eres increíble.)" },
        { "role": "moon", "en": "A girl is eating an apple. What is she doing?", "es": "Una niña está comiendo una manzana. ¿Qué está haciendo?" },
        { "role": "student", "en": "(Say: She is eating an apple. The apple is yummy!)", "es": "(Di: Ella está comiendo una manzana. ¡La manzana es deliciosa!)" },
        { "role": "moon", "en": "Two friends are playing and laughing. What are they doing?", "es": "Dos amigos están jugando y riendo. ¿Qué están haciendo?" },
        { "role": "student", "en": "(Say: They are playing. They are happy!)", "es": "(Di: Están jugando. ¡Están felices!)" },
        { "role": "moon", "en": "What about you? What are you doing right now?", "es": "¿Y tú? ¿Qué estás haciendo ahora mismo?" },
        { "role": "student", "en": "(Say: I am talking to Moon! I am learning English.)", "es": "(Di: ¡Estoy hablando con Moon! Estoy aprendiendo inglés.)" },
        { "role": "moon", "en": "Wonderful! The festival is amazing. Thank you for coming!", "es": "¡Maravilloso! El festival es increíble. ¡Gracias por venir!" },
        { "role": "student", "en": "(Say goodbye and thank Moon for the festival!)", "es": "(Despídete y agradece a Moon por el festival.)" }
      ]
    }
  ]
