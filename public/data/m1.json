  "evaluations": [
    {
      "id": "m1_eval_1",
      "title": "Conversación en el Campamento",
      "preview": {
        "en": "You are at the camp. Moon welcomes you. Greet each other and talk about how you feel.",
        "es": "Estás en el campamento. Moon te da la bienvenida. Salúdense y hablen sobre cómo se sienten."
      },
      "lines": [
        { "role": "moon", "en": "Hello! Welcome to Moonsforest!", "es": "¡Hola! ¡Bienvenido a Moonsforest!" },
        { "role": "student", "en": "Hello Moon! I am happy to be here.", "es": "¡Hola Moon! Estoy feliz de estar aquí." },
        { "role": "moon", "en": "What is your name?", "es": "¿Cuál es tu nombre?" },
        { "role": "student", "en": "My name is [your name]. I am a student.", "es": "Mi nombre es [tu nombre]. Soy un estudiante." },
        { "role": "moon", "en": "How are you today?", "es": "¿Cómo estás hoy?" },
        { "role": "student", "en": "I am happy and ready!", "es": "¡Estoy feliz y listo!" },
        { "role": "moon", "en": "Are you a boy or a girl?", "es": "¿Eres niño o niña?" },
