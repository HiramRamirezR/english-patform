rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             firestore.exists(/databases/(default)/documents/users/(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // —— Grabaciones de evaluación: solo el alumno sube, admin/teacher lee ——
    match /evaluations/{userId}/{fileName} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // —— Avatares de perfil ——
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // —— Todo lo demás: solo admin ——
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
